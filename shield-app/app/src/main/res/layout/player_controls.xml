<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Quick seek bar — shown on D-pad left/right only -->
    <LinearLayout
        android:id="@+id/quick_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/quick_seek_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:text="0:00" />

            <SeekBar
                android:id="@+id/quick_seek_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:progressDrawable="@drawable/seekbar_nvidia_green"
                android:thumb="@drawable/seekbar_thumb_green"
                android:thumbOffset="0dp"
                android:minHeight="3dp"
                android:maxHeight="3dp"
                android:focusable="false"
                android:clickable="false"
                android:max="1000" />

            <TextView
                android:id="@+id/quick_seek_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:text="0:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- Full controls — shown on center button -->
    <LinearLayout
        android:id="@+id/full_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/controls_gradient"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="24dp"
        android:paddingTop="64dp"
        android:visibility="gone">

        <!-- Title row -->
        <TextView
            android:id="@+id/controls_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Channel name -->
        <TextView
            android:id="@+id/controls_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B0FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <!-- Seek bar row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/controls_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:text="0:00" />

            <SeekBar
                android:id="@+id/controls_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:progressDrawable="@drawable/seekbar_nvidia_green"
                android:thumb="@drawable/seekbar_thumb_green"
                android:thumbOffset="0dp"
                android:minHeight="3dp"
                android:maxHeight="3dp"
                android:focusable="true"
                android:max="1000" />

            <TextView
                android:id="@+id/controls_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:text="0:00" />
        </LinearLayout>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_prev_chapter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous chapter"
                android:layout_marginEnd="24dp"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btn_rewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_rew"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rewind 15s"
                android:layout_marginEnd="24dp"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_media_pause"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play/Pause"
                android:layout_marginEnd="24dp"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_ff"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward 15s"
                android:layout_marginEnd="24dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_cc"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="CC"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Closed captions"
                android:layout_marginEnd="24dp"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/btn_next_chapter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next chapter"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
